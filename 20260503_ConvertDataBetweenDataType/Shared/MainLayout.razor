@inherits LayoutComponentBase

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" class="rz-p-4">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel Text="🔁 Data Type Converter" Style="font-size:1.4rem; font-weight:700; color:var(--rz-text-color)" />
            <span style="flex:1"></span>
            <RadzenLabel Text="Blazor + Radzen | .NET 8" Style="font-size:0.85rem; opacity:0.6" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Chuyển đổi cơ bản" Icon="swap_horiz" Path="/" />
            <RadzenPanelMenuItem Text="PLC / SCADA Types" Icon="memory" Path="/plc" />
            <RadzenPanelMenuItem Text="Bảng tham khảo" Icon="table_chart" Path="/reference" />
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>

    <RadzenFooter>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" class="rz-p-2">
            <RadzenLabel Text="© 2026 ConvertDataBetweenDataType — Phúc Thịnh Automation." Style="font-size:0.8rem; opacity:0.5" />
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>

@code {
    bool sidebarExpanded = true;
}
