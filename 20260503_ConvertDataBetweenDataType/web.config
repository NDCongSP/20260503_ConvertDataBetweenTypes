<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config dùng cho deploy lên IIS với ASP.NET Core Module (ANCM).
  Khi publish, file này được copy vào thư mục publish output.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- Chuyển toàn bộ request tới ASP.NET Core Module -->
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\ConvertDataBetweenDataType.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
<!--
  Để bật stdout log khi debug trên IIS:
  1. Tạo thư mục "logs" trong thư mục gốc app
  2. Đổi stdoutLogEnabled="true"
  3. Xem log tại .\logs\stdout_*.log
-->
